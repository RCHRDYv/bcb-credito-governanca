        "$value": "{color.gray.10}",
        "$description": "Fundo da página (background)",
        "$extensions": {
          "credito-pj": {
            "escuro": "{color.gray.100}"
          }
        }
      },
      "layer": {
        "$value": "{color.white}",
        "$description": "Camada sólida (layer-01)",
        "$extensions": {
          "credito-pj": {
            "escuro": "{color.gray.90}"
          }
        }
      },
      "layer-hover": {
        "$value": "{color.hover.gray-10}",
        "$description": "Camada com o mouse em cima (layer-hover-01)",
