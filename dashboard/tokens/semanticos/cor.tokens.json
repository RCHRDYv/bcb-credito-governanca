        "$value": "{color.white}",
        "$description": "Fundo sólido dos cartões de gráfico. O dado fica firme (ADR 0020): as cores dos gráficos são medidas contra este fundo, e no escuro o cinza 100 dá folga à ponta das rampas (ADR 0021)",
        "$extensions": {
          "credito-pj": {
            "escuro": "{color.gray.100}"
          }
        }
      },
