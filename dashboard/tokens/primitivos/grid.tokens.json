{
  "grid": {
    "$description": "O grid 2x do Carbon, do pacote @carbon/grid 11.63.0. Pontos de quebra, colunas, margens e calhas.",
    "breakpoint": {
      "$type": "dimension",
      "sm": { "$value": { "value": 320, "unit": "px" } },
      "md": { "$value": { "value": 672, "unit": "px" } },
      "lg": { "$value": { "value": 1056, "unit": "px" } },
      "xlg": { "$value": { "value": 1312, "unit": "px" } },
      "max": { "$value": { "value": 1584, "unit": "px" } }
    },
    "columns": {
      "$type": "number",
      "sm": { "$value": 4 },
      "md": { "$value": 8 },
      "lg": { "$value": 16 },
      "xlg": { "$value": 16 },
      "max": { "$value": 16 }
    },
    "margin": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 16, "unit": "px" } },
      "xlg": { "$value": { "value": 16, "unit": "px" } },
      "max": { "$value": { "value": 24, "unit": "px" } }
    },
    "gutter": {
      "$type": "dimension",
      "larga": { "$value": { "value": 32, "unit": "px" }, "$description": "O padrão" },
      "estreita": {
        "$value": { "value": 16, "unit": "px" },
        "$description": "Painéis e conteúdo mais junto"
      },
      "condensada": {
        "$value": { "value": 1, "unit": "px" },
        "$description": "Tabelas e listas densas"
      }
    }
  }
}
