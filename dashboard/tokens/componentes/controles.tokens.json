{
  "botao": {
    "$description": "Botões em cápsula, do guia do design system (#62 e #64).",
    "altura": {
      "$type": "dimension",
      "$value": "{size.controle}"
    },
    "raio": {
      "$type": "dimension",
      "$value": "{radius.capsula}"
    },
    "primario": {
      "fundo": {
        "$type": "color",
        "$value": "{color.background.brand.default}"
      },
      "fundo-hover": {
        "$type": "color",
        "$value": "{color.background.brand.hover}"
      },
      "fundo-pressionado": {
        "$type": "color",
        "$value": "{color.background.brand.pressed}"
      },
      "texto": {
        "$type": "color",
        "$value": "{color.text.on-color}"
      }
    }
  },
  "foco": {
    "$description": "O anel de foco, sempre visível",
    "anel": {
      "largura": {
        "$type": "dimension",
        "$value": "{border.foco}"
      },
      "cor": {
        "$type": "color",
        "$value": "{color.focus}"
      }
    }
  },
  "segmentado": {
    "$description": "Controle segmentado (#64): a gota de vidro que marca a opção escolhida. No escuro, o branco a 14% destaca a gota sobre o trilho sem virar uma mancha clara.",
    "gota": {
      "$type": "color",
      "$value": "{color.transparente.branco.95}",
      "$extensions": {
        "credito-pj": {
          "escuro": "{color.transparente.branco.14}"
        }
      }
    }
  },
  "aviso": {
    "$description": "Avisos (#64). No de atenção, o círculo é o amarelo de atenção e o glifo fica escuro nos dois temas, como faz o Carbon.",
    "atencao": {
      "glifo": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$extensions": {
          "credito-pj": {
            "escuro": "{color.gray.100}"
          }
        }
      }
    }
  }
}
