# PT: Não roda script de instalação de nenhum pacote. Os pacotes do IBM Plex
#     tentam rodar telemetria da IBM na instalação, e nenhum pacote do site
#     precisa de script para funcionar.
# EN: No package install scripts run. The IBM Plex packages try to run IBM
#     telemetry on install, and no site package needs an install script.
ignore-scripts=true
